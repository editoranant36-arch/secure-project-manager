# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments
venv/
env/
ENV/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Secrets and environment configs (Do NOT commit .env!)
.env
.env.local
.env.*.local

# Instance & local database files
instance/*.db
instance/*.sqlite
instance/*.sqlite3
!instance/.gitkeep

# Storage / Uploads
storage/uploads/*
!storage/uploads/.gitkeep
storage/test_uploads/*

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# IDE & Editor settings
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Root archives and bundles
/*.tar.gz
/*.zip
/*.tar
