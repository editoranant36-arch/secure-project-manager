# Application Environment Configuration
FLASK_APP=run.py
FLASK_ENV=development
DEBUG=True

# Security Keys
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret-key-at-least-32-bytes

# Fernet Key for TOTP Secret Encryption at rest
# Generate FERNET_KEY with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace-with-a-valid-fernet-key-32-urlsafe-base64-bytes

# Database Configuration (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///instance/app.db

# Storage Configuration
UPLOAD_FOLDER=storage/uploads
MAX_CONTENT_LENGTH=52428800  # 50 MB max per upload request
MAX_STORAGE_PER_USER_MB=500  # 500 MB per user storage quota

# Security & Session Settings
SESSION_COOKIE_SECURE=False  # Set to True in production with HTTPS
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=3600  # 1 hour
